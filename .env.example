# toolforge envvars create FLASK_SECRET_KEY "......"
# ============================================================
# application environment
# ============================================================
# production | development | testing
APP_ENV=development
FLASK_ENV=development

# ============================================================
# Security (Flask 3.1+ features)
# ============================================================

# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET_KEY=......

# Salt used alongside the secret key for derived tokens
SECRET_SALT=app

# Comma-separated fallback secret keys for key rotation
SECRET_KEY_FALLBACKS=

# Maximum request size in bytes (default 100MB)
MAX_CONTENT_LENGTH=104857600

# Maximum form data held in memory in bytes (default 16MB)
MAX_FORM_MEMORY_SIZE=16777216

# Maximum number of form fields per request (default 1000)
MAX_FORM_PARTS=1000
# CSRF token lifetime in seconds (default 3600)
WTF_CSRF_TIME_LIMIT=3600

# ============================================================
# Paths / data directories
# ============================================================
# Root for svg_data/, logs/, svg_jobs/, main_files/, etc.
MAIN_DIR=~/data

# Optional path to a local CopySVGTranslation package directory (dev only)
CopySVGTranslation_PATH=

# ============================================================
# Database (Toolforge toolsdb)
# ============================================================

DATABASE_URI=mysql+pymysql://root:root11@127.0.0.1/wleye_db?charset=utf8mb4

# ============================================================
# MediaWiki OAuth
# ============================================================
# MediaWiki domain to operate against (default commons.wikimedia.org)
OAUTH_MWURI=https://www.wiki.org/w/index.php
OAUTH_CONSUMER_KEY=your_consumer_key
OAUTH_CONSUMER_SECRET=your_consumer_secret

# Generate URL-safe 32-byte Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=....

WIKI_DOMAIN=www.wiki.org # or test-commons.wikimedia.org
# ============================================================
# Cookies / session
# ============================================================

AUTH_COOKIE_NAME=uid_enc
AUTH_COOKIE_MAX_AGE=2592000  # 30 days
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1

# Flask session key names
STATE_SESSION_KEY=oauth_state_nonce
REQUEST_TOKEN_SESSION_KEY=state
REQUEST_SECRET_SESSION_KEY=oauth_request_secret

# ============================================================
# CORS
# ============================================================

# Comma-separated list of allowed domains (empty → built-in defaults)
CORS_ALLOWED_DOMAINS=medwiki.toolforge.org,mdwikicx.toolforge.org

# ============================================================
# jobs / background workers
# ============================================================
# Background job runner sizing
JOBS_MAX_WORKERS=2
JOBS_LOG_LINES=200
# Per-item job priority (0 disables priority)
PRIORITY_PER_ITEM=0

# Set to true when running jobs via cron/background (skips user OAuth)
CRON_JOB=false

# ============================================================
# misc / other
# ============================================================
# Static asset CDN base URL
STATIC_SERVER=https://cdnjs.cloudflare.com
# Tool title displayed in the UI
TOOL_TITLE=
# User agent for wiki API requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3

# ============================================================
# network tests: tests/network/network_conftest.py
# ============================================================
MW_TEST_USERNAME=
MW_TEST_PASSWORD=
