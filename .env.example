# toolforge envvars create FLASK_SECRET_KEY "............"

# Application environment (production, development, testing)
APP_ENV=development
FLASK_ENV=development

STATIC_SERVER=https://cdnjs.cloudflare.com

# python -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET_KEY=

# SecurityConfig (Flask 3.1+ features)
# Salt used for security-related hashing
SECRET_SALT=svg-translate
# Comma-separated fallback secret keys for rotation
SECRET_KEY_FALLBACKS=
# Maximum request size in bytes (default 100MB)
MAX_CONTENT_LENGTH=104857600
# Maximum form data in memory in bytes (default 16MB)
MAX_FORM_MEMORY_SIZE=16777216
# Maximum number of form fields (default 1000)
MAX_FORM_PARTS=1000

# Tool title displayed in the UI
TOOL_TITLE=Copy SVG Translations
# MediaWiki domain to operate against (default commons.wikimedia.org)
WIKI_DOMAIN=www.wiki.org # or test-commons.wikimedia.org
# CSRF token lifetime in seconds (default 3600)
WTF_CSRF_TIME_LIMIT=3600
# User agent for wiki API requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3

# Background job runner sizing
JOBS_MAX_WORKERS=2
JOBS_LOG_LINES=200
# Per-item job priority (0 disables priority)
PRIORITY_PER_ITEM=0

MAIN_DIR=~/data

TOOL_TOOLSDB_DBNAME=db_name

# TOOL_TOOLSDB_HOST=tools.db.svc.wikimedia.cloud
TOOL_TOOLSDB_HOST=127.0.0.1
TOOL_TOOLSDB_USER=root
TOOL_TOOLSDB_PASSWORD=root

OAUTH_MWURI=https://www.wiki.org/w/index.php
OAUTH_CONSUMER_KEY=x
OAUTH_CONSUMER_SECRET=x

# Generate URL-safe 32-byte Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=x

# CORS allowed domains (comma-separated)
CORS_ALLOWED_DOMAINS=medwiki.toolforge.org,mdwikicx.toolforge.org

AUTH_COOKIE_NAME=uid_enc
AUTH_COOKIE_MAX_AGE=2592000  # 30 days
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

REQUEST_TOKEN_SESSION_KEY=state
STATE_SESSION_KEY=oauth_state
REQUEST_SECRET_SESSION_KEY=oauth_request_secret

# CRON_JOB=true when running jobs via cron/background (skips user OAuth)
CRON_JOB=false

# Path to a local CopySVGTranslation package directory (optional, dev only)
CopySVGTranslation_PATH=

# --- Offline tool: _works_files/rename_owid_pages.py (reads from .env) ---
WIKI_USERNAME=
WIKI_PASSWORD=

# --- Network tests (tests/network/network_conftest.py) ---
MW_TEST_USERNAME=
MW_TEST_PASSWORD=
